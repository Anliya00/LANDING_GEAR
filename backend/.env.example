# Copy this file to .env and fill in your values. .env is gitignored.

# --- Oracle -----------------------------------------------------------------
# python-oracledb runs in thin mode, so no Oracle Instant Client is needed.
# DSN is host:port/service_name
ORACLE_USER=sftad
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/XEPDB1

# Connection pool
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=8

# --- Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=sftad_session
# Hours a normal session lasts, refreshed on use (sliding expiry).
SESSION_IDLE_HOURS=12
# Hours a "Keep me signed in" session lasts.
SESSION_REMEMBER_HOURS=336
# Set to true only when the app is served over HTTPS. On plain HTTP the
# browser silently drops a Secure cookie and login appears to do nothing.
SESSION_COOKIE_SECURE=false

# --- Lockout ----------------------------------------------------------------
MAX_FAILED_ATTEMPTS=8
LOCKOUT_MINUTES=15

# --- CORS -------------------------------------------------------------------
# The Vite dev server origin. Credentials are allowed, so this cannot be "*".
CORS_ORIGINS=http://localhost:5173
